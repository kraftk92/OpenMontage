{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/sample_review",
  "title": "Representative visual sample review",
  "type": "object",
  "required": ["version", "sample_path", "sample_sha256", "duration_seconds", "scene_ids", "basis_digest", "render_runtime", "composition_mode", "review"],
  "properties": {
    "version": { "const": "1.0" },
    "sample_path": { "type": "string", "minLength": 1 },
    "sample_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 8, "description": "5–8 seconds; an approved film shorter than 5 seconds is sampled in full." },
    "scene_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "basis_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "render_runtime": { "enum": ["remotion", "hyperframes", "ffmpeg"] },
    "composition_mode": { "enum": ["atelier", "templated"] },
    "review": {
      "type": "object",
      "required": ["frames_inspected", "playback_reviewed", "checks", "unresolved_blockers"],
      "properties": {
        "frames_inspected": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "playback_reviewed": { "const": true },
        "checks": {
          "type": "object", "required": ["exact_copy", "readability", "visual_direction", "factual_accuracy", "meaningful_motion"],
          "properties": {
            "exact_copy": { "const": "pass" },
            "readability": { "const": "pass" },
            "visual_direction": { "const": "pass" },
            "factual_accuracy": { "const": "pass" },
            "meaningful_motion": { "const": "pass" }
          },
          "additionalProperties": false
        },
        "unresolved_blockers": { "type": "array", "maxItems": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
